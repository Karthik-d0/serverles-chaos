# Copy to .env (never commit .env). docker compose reads it automatically; the sls-chaos CLI loads it too.

# --- needed by the LocalStack container only (docker-compose.yml) ---
LOCALSTACK_AUTH_TOKEN=

# --- used by the sls-chaos CLI / adapters (defaults shown) ---
SC_ENDPOINT_URL=http://localhost:4566
# URL the Lambda *containers* use to reach LocalStack (differs from the host URL on some Docker setups)
SC_LAMBDA_ENDPOINT_URL=http://localhost.localstack.cloud:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- only for --generator llm / llm-open (any OpenAI-compatible endpoint) ---
# Local (Ollama):  SC_LLM_BASE_URL=http://localhost:11434/v1  SC_LLM_MODEL=llama3.1
# Cloud:           SC_LLM_BASE_URL=https://api.openai.com/v1  SC_LLM_MODEL=gpt-4o-mini  SC_LLM_API_KEY=...
SC_LLM_BASE_URL=
SC_LLM_MODEL=
SC_LLM_API_KEY=
